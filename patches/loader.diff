+function updateCircularProgress(value: number, status?: string): void {
+	const progressBar = mainWindow.document.querySelector('.progress-bar') as SVGCircleElement;
+	const progressText = mainWindow.document.querySelector('.progress-text') as HTMLElement;
+	const statusText = mainWindow.document.querySelector('#loading-status-text') as HTMLElement;
+
+	if (!progressBar || !progressText || !statusText) {
+		return;
+	}
+
+	// Circular progress calculation
+	const circumference = 125.66;
+	const clampedValue = Math.min(100, Math.max(0, value));
+	const offset = circumference - (clampedValue / 100 * circumference);
+
+	// Apply the progress value
+	progressBar.style.strokeDashoffset = offset.toString();
+
+	// Update text with rounded value
+	progressText.textContent = `${Math.round(clampedValue)}%`;
+
+	// Apply completion styling when reaching 100%
+	if (clampedValue === 100) {
+		progressBar.classList.add('complete');
+		progressText.classList.add('complete', 'success');
+	}
+
+	// Update status text if provided
+	if (status) {
+		statusText.textContent = status;
+	}
+}
+
 (function () {
 
 	// Find config by checking for DOM
@@ -642,4 +674,24 @@ class WorkspaceProvider implements IWork
 			? undefined /* with a remote without embedder-preferred storage, store on the remote */
 			: new LocalStorageSecretStorageProvider(secretStorageCrypto),
 	});
+
+	// Update progress bar to 100% before removing loader
+	try {
+		updateCircularProgress(100, 'Workspace ready!');
+
+		// Wait for 1 second to show the completed progress before removing the loader
+		setTimeout(() => {
+			const loaderElement = mainWindow.document.getElementById('vscode-loader');
+			if (loaderElement) {
+				mainWindow.document.body.removeChild(loaderElement);
+			}
+		}, 1000); // 1 second delay to show the completed progress
+	} catch (error) {
+		// Fallback: remove immediately if progress update fails
+		console.warn('Failed to update progress bar:', error);
+		const loaderElement = mainWindow.document.getElementById('vscode-loader');
+		if (loaderElement) {
+			mainWindow.document.body.removeChild(loaderElement);
+		}
+	}
 })();
