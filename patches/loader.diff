+
+/* Loading page styles matching Devant */
+.vscode-deployment-root {
+	display: flex;
+	flex-direction: column;
+	justify-content: center;
+	align-items: center;
+	min-height: 100vh;
+	padding: 24px;
+}
+
+.vscode-deployment-header-box {
+	display: flex;
+	text-align: center;
+	flex-direction: column;
+	max-width: 372px;
+	margin-bottom: 32px;
+}
+
+.vscode-deployment-header-box h3 {
+	font-size: 1.375rem; /* 22px converted to rem (22/16) */
+	font-weight: medium;
+	font-stretch: normal;
+	font-style: normal;
+	line-height: 1.4;
+	letter-spacing: normal;
+	margin: 0;
+	font-family: 'Gilmer Medium';
+}
+
+.vscode-deployment-content-box {
+	display: flex;
+	flex-direction: column;
+	justify-content: center;
+	align-items: center;
+	margin: 24px 0;
+}
+
+.vscode-deployment-image-box {
+	display: flex;
+	justify-content: center;
+	align-items: center;
+	max-width: 300px;
+	margin: 0 auto;
+}
+
+.vscode-deployment-img-fluid {
+	width: 100%;
+	height: auto;
+	align-items: center;
+}
+
+.vscode-deployment-loading-box {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+}
+
+.vscode-deployment-progress-box {
+	margin: 16px 0;
+}
+
+.vscode-deployment-text-box h5 {
+	font-size: 0.8125rem; /* 13px converted to rem (13/16) */
+	font-weight: 600;
+	font-stretch: normal;
+	font-style: normal;
+	line-height: 1.8;
+	letter-spacing: normal;
+	margin: 0;
+	color: #2f5fa7;
+	font-family: 'Gilmer';
+}
+
+/* Circular Progress Styles */
+.circular-progress-container {
+	position: relative;
+	display: inline-flex;
+	align-items: center;
+	justify-content: center;
+	width: 40px;
+	height: 40px;
+}
+
+.circular-progress {
+	transform: rotate(-90deg);
+	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+	width: 100%;
+	height: 100%;
+}
+
+.progress-background {
+	stroke: rgba(252, 252, 252, 0.988);
+	stroke-linecap: round;
+}
+
+.progress-bar {
+	stroke: #2f5fa7;
+	stroke-dasharray: 100.53;
+	stroke-dashoffset: 30.16; /* Start at 70% (100.53 - (0.7 * 100.53)) */
+	transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
+	stroke-linecap: round;
+}
+
+.progress-bar.complete {
+	stroke: #2f5fa7;
+	stroke-dashoffset: 0;
+}
+
+.progress-text {
+	position: absolute;
+	top: 0;
+	left: 0;
+	bottom: 0;
+	right: 0;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	font-size: 0.7rem;
+	font-weight: 500;
+	color: #1d2028;
+	letter-spacing: 0.02em;
+	line-height: 1;
+	font-family: 'Gilmer';
+}
+
+.progress-text.complete {
+	font-size: 0.6rem;
+	color: #1d2028;
+}
+
+.progress-text.success {
+	color: #1d2028;
+}
+
+/* Responsive design */
+@media (max-width: 768px) {
+	.vscode-deployment-root {
+		padding: 16px;
+	}
+
+	.vscode-deployment-header-box {
+		margin-bottom: 24px;
+		max-width: 100%;
+	}
+
+	.vscode-deployment-header-box h1 {
+		font-size: 1.25rem;
+	}
+
+	.vscode-deployment-content-box {
+		max-width: 100%;
+	}
+
+	.vscode-deployment-img-fluid {
+		max-width: 150px;
+	}
+}
